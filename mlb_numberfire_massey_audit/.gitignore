# Environment
.env
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Data outputs (keep dir structure via .gitkeep, ignore generated content)
data/raw/numberfire/*
data/raw/odds/*
data/processed/*
data/results/*
data/reports/*
data/logs/*
