# Copy this file to .env and fill in values as needed.
# Everything has a sensible default in config.py, so .env is optional.

# Root directory for all data (raw, manual, processed, results, reports, logs).
DATA_DIR=data

# User-Agent string used by the numberFire scraper. Leave blank to use a
# polite default. Set a descriptive UA with contact info if you scrape.
NUMBERFIRE_USER_AGENT=

# Polite rate limiting: seconds to sleep between HTTP requests.
SLEEP_SECONDS=2

# Max retries for HTTP requests.
MAX_RETRIES=3

# Predictive-model edge threshold (numberFire prob - market implied prob).
# 0.03 = 3 percentage points.
EDGE_THRESHOLD_NF=0.03

# Minimum theoretical EV for a candidate to be labeled a value play.
MIN_EV_THRESHOLD=0.00

# Massey agreement thresholds, in runs of projected home margin.
MASSEY_AGREE_MARGIN_RUNS=0.25
MASSEY_CONFLICT_MARGIN_RUNS=-0.25

# Home-field advantage applied to Massey projected margins, in runs.
DEFAULT_HOME_FIELD_RUNS=0.15

# Odds source: "manual" (CSV) or "api" (The Odds API, requires ODDS_API_KEY).
ODDS_SOURCE=manual
ODDS_API_KEY=

# The Odds API (the-odds-api.com) settings. Only used when ODDS_SOURCE=api.
ODDS_API_BASE=https://api.the-odds-api.com
ODDS_API_SPORT=baseball_mlb
ODDS_API_REGIONS=us
# Optional: restrict to specific books, e.g. draftkings,fanduel. Blank = all.
ODDS_API_BOOKMAKERS=
# historical | current | auto  (auto = historical for past dates, current for today/future)
ODDS_API_MODE=auto
# US/Eastern hour to anchor each historical snapshot (12 = noon ET, pre-game).
ODDS_API_SNAPSHOT_HOUR_ET=12

# Enable Wayback/CDX backfill attempts for historical numberFire pages.
ENABLE_WAYBACK_BACKFILL=False

# Save raw HTML/JSON responses to data/raw for auditing.
SAVE_RAW_RESPONSES=True

# Season year used by the --season command.
SEASON_YEAR=2026
